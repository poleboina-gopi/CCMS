# ==============================================================================
# CampusResolve CCMS - Environment Variables Configuration Template
# Copy this file to '.env' and fill in your production values before deployment.
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret Key (Generate a random 64-character string for production)
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Atlas URI (For Cloud Production Deployment)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ccms?retryWrites=true&w=majority

# SMTP Email Configuration (Optional - leave blank for local development logging)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# FROM_EMAIL="CampusResolve Helpdesk" <notifications@yourcampus.edu>

# Frontend Client URL (For CORS whitelist in production)
# CLIENT_URL=https://your-frontend-domain.vercel.app
